AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Comma-separated extra browser origins allowed to POST to APIs.
# The deployment's own Origin is always allowed automatically.
# Example: https://preview.example.com,http://localhost:5173
ALLOWED_ORIGINS=

# Optional: English pronunciation/prosody assessment.
# If omitted, the app keeps normal interview coaching and marks pronunciation assessment unavailable.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
